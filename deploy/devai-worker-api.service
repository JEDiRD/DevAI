[Unit]
Description=Dev AI Worker Control API (Tailscale only)
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/devai-platform
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/devai-platform/deploy/run-worker-api.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
