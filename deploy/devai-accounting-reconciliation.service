[Unit]
Description=DevAI metered accounting evidence reconciliation
After=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/devai-platform
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/devai-platform/deploy/run-accounting-reconciliation.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TimeoutStartSec=60

